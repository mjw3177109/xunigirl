# 将文件复制为 .env，并填写 DeepSeek API Key（请勿上传或截图）
DEEPSEEK_API_KEY=sk-请替换为你自己的密钥
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=1024

# 可选：0.6=更省显存，1.7=质量优先（改动后重跑 INSTALL.cmd + CONFIGURE_VOICE.cmd）
TTS_SIZE=0.6

# RTX 4090 数字人口播默认：最低显存声音克隆。实际请先运行 SELECT_4090_VIDEO_MIN.cmd。
STT_DEVICE=cpu
TTS_DEVICE=cuda
DIGITAL_HUMAN_ENABLED=0
